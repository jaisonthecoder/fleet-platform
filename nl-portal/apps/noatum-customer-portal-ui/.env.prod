# Public browser configuration only. Never put secrets in VITE_* values.
# Set the production API URL at build time when the API client integration is enabled.
VITE_API_BASE_URL=
# The public surfaces (track and trace, counters, CO2e calculator, access
# request) have no API routes yet. While this is true an in-browser stand-in
# answers them with real status codes and latency. It stays off outside local
# development: a deployed build must never show a sample shipment as if it were
# real. Turn it on the day you need the page reviewed without the API, and
# delete src/api/public/mock once /api/public/* exists.
VITE_PUBLIC_API_MOCK=false
