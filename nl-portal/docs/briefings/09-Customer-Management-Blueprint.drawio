                </mxCell>
                <mxCell id="row1" value="&lt;b&gt;[Customer name]&lt;/b&gt;     Active&lt;br&gt;[Country] | [linked org count]&lt;br&gt;[Servicing branch]&lt;br&gt;First admin: Accepted       Open" link="data:page/detail" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
                    <mxGeometry x="60" y="440" width="350" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="row2" value="&lt;b&gt;[Customer name]&lt;/b&gt;     Onboarding&lt;br&gt;[Country] | [linked org count]&lt;br&gt;[Servicing branch]&lt;br&gt;First admin: Invited           Open" link="data:page/detail" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=16;align=left;spacing=14;" vertex="1" parent="1">
                    <mxGeometry x="60" y="575" width="350" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="pager" value="Previous        [Page]        Next" style="text;html=1;fontFamily=Mulish;fontSize=16;" vertex="1" parent="1">
                    <mxGeometry x="60" y="725" width="350" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="phone2" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#002C5F;strokeWidth=2;" vertex="1" parent="1">
                    <mxGeometry x="470" y="120" width="390" height="675" as="geometry"/>
                </mxCell>
                <mxCell id="header2" value="Back      Invite user      Close" style="rounded=0;html=1;fillColor=#002C5F;strokeColor=none;fontFamily=Mulish;fontSize=18;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="470" y="120" width="390" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="form" value="Customer: [fixed group]&lt;br&gt;&lt;br&gt;Display name *&lt;br&gt;[input]&lt;br&gt;&lt;br&gt;Company email *&lt;br&gt;[input]&lt;br&gt;&lt;br&gt;Locale *&lt;br&gt;[English / Spanish]&lt;br&gt;&lt;br&gt;Role presets *&lt;br&gt;[multi-select]&lt;br&gt;&lt;br&gt;Financial office&lt;br&gt;[All permitted / office]&lt;br&gt;&lt;br&gt;[Validation message near field]" style="text;html=1;whiteSpace=wrap;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="490" y="200" width="350" height="485" as="geometry"/>
                </mxCell>
                <mxCell id="send" value="Send invitation" style="rounded=0;html=1;fillColor=#AA272F;strokeColor=none;fontFamily=Mulish;fontSize=16;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="490" y="720" width="350" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="gates" value="&lt;b&gt;Approval gates before implementation&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. D-03 / OQ-3a: source IDs, address/contact&lt;br&gt;   collections, source-company branch mapping.&lt;br&gt;&lt;br&gt;2. D-04: exact internal/customer action grants.&lt;br&gt;&lt;br&gt;3. D-13: optional second-person linking policy;&lt;br&gt;   customer/legal-entity grouping constraints.&lt;br&gt;&lt;br&gt;4. D-18: region model, supported setting scopes,&lt;br&gt;   precedence and multi-branch servicing.&lt;br&gt;&lt;br&gt;5. Identity: invitation-only provisioning flow;&lt;br&gt;   no local authentication implementation.&lt;br&gt;&lt;br&gt;6. Unlink / reassignment / branch disable effects&lt;br&gt;   on active users, claims and historical records.&lt;br&gt;&lt;br&gt;Keep runtime and approved FRs unchanged&lt;br&gt;until these design decisions are accepted." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="900" y="120" width="500" height="675" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="RESPONSIVE / ACCESSIBILITY | Narrow layouts use stacked labelled rows or a deliberate scrollable table; preserve primary identity and state.&lt;br&gt;Detail tabs remain keyboard-operable and horizontally scrollable; drawers become full-width dialogs. Forms become single-column.&lt;br&gt;No viewport-scaled fonts, tiny muted metadata or hidden primary actions. Wrap long names/domains; provide visible focus and text labels for states.&lt;br&gt;Implementation uses Noatum tokens, Mulish, square sections, accessible text colours, EN/ES and DD.MM.YYYY with timezone for timestamps.&lt;br&gt;No permanent architecture tutorial, floating section-card nesting or oversized footer consuming an operational workspace.&lt;br&gt;This is a design artifact. XML/link/layout validation does not prove browser accessibility, backend controls or implemented workflows." style="text;html=1;whiteSpace=wrap;fontFamily=Mulish;fontSize=17;fontColor=#58595B;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="40" y="850" width="1360" height="220" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
