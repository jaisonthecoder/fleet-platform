                    <mxGeometry x="40" y="550" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="audit" value="&lt;b&gt;Time / timezone                Actor                     Action                     Target                 Outcome&lt;/b&gt;&lt;br&gt;&lt;br&gt;[DD.MM.YYYY HH:mm]      [original actor]       Organisation linked    [source + org]       [result]&lt;br&gt;[DD.MM.YYYY HH:mm]      [original actor]       User deactivated        [user reference]    [result]&lt;br&gt;[DD.MM.YYYY HH:mm]      [original actor]       Policy changed           [scope + revision] [result]&lt;br&gt;&lt;br&gt;Previous / Next                 Select row to inspect authorised details" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
