    <diagram id="guide" name="00 Review and concept model">
        <mxGraphModel dx="0" dy="770" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1020" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="NOATUM LOGISTICS | Customer management blueprint" style="text;html=1;fontFamily=Mulish;fontSize=26;fontStyle=1;fontColor=#002C5F;align=left;" parent="1" vertex="1">
                    <mxGeometry x="40" y="30" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="scope" value="11.09.2026 | Proposed UX for approval | Editable native draw.io shapes | No application or requirement changes" style="text;html=1;fontFamily=Mulish;fontSize=16;align=left;fontColor=#58595B;" parent="1" vertex="1">
                    <mxGeometry x="40" y="90" width="1350" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="verdict" value="&lt;b&gt;Verdict: retain the customer workspace; correct its organisation and operating-branch model.&lt;/b&gt;&lt;br&gt;The five screenshots cover useful customer administration, but do not yet define an end-to-end onboarding design." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F7ECEC;strokeColor=#AA272F;fontFamily=Mulish;fontColor=#333333;fontSize=18;align=left;spacing=20;" parent="1" vertex="1">
                    <mxGeometry x="40" y="145" width="1360" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="keep" value="&lt;b&gt;Keep&lt;/b&gt;&lt;br&gt;&lt;br&gt;Customers list and onboarding entry&lt;br&gt;Overview / organisations / users / hierarchy / audit&lt;br&gt;Organisation-level linking and address expansion&lt;br&gt;Noatum invites first admin; customers manage colleagues&lt;br&gt;Invitation resend/revoke, customer suspension&lt;br&gt;Read-only, reasoned impersonation (FR-IAM-012)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;fontColor=#333333;align=left;verticalAlign=top;spacing=20;" parent="1" vertex="1">
                    <mxGeometry x="40" y="265" width="650" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="change" value="&lt;b&gt;Correct before implementation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Add a branch becomes Link organisation&lt;br&gt;Separate CW1 directory from unassigned transactions&lt;br&gt;Separate servicing branch from customer addresses&lt;br&gt;Do not mandate second approval unless signed off&lt;br&gt;Feature entitlement is not a user permission or release&lt;br&gt;Remove identity tutorials from every working page" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;fontColor=#333333;align=left;verticalAlign=top;spacing=20;" parent="1" vertex="1">
                    <mxGeometry x="730" y="265" width="670" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="source" value="&lt;b&gt;CW1 business-party master&lt;/b&gt;&lt;br&gt;Organisation + source identity&lt;br&gt;Repeatable addresses and contacts&lt;br&gt;Source fields read-only&lt;br&gt;Import grants no portal access" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#002C5F;fontFamily=Mulish;fontSize=17;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="40" y="560" width="360" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="tenant" value="&lt;b&gt;Portal CustomerGroup&lt;/b&gt;&lt;br&gt;Deliberate CustomerAccount links&lt;br&gt;Users, role presets, entitlements&lt;br&gt;Two-level hierarchy only&lt;br&gt;Address is not another tenant link" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Mulish;fontSize=17;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="540" y="560" width="370" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="ops" value="&lt;b&gt;Noatum operating structure&lt;/b&gt;&lt;br&gt;Source company / servicing branch&lt;br&gt;Staff branch assignment&lt;br&gt;Region model: decision-gated&lt;br&gt;Country does not decide access" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#002C5F;fontFamily=Mulish;fontSize=17;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1040" y="560" width="360" height="150" as="geometry"/>
