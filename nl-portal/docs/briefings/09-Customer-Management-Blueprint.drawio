                    <mxGeometry x="60" y="315" width="350" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="filters" value="All / Active / Onboarding     Filters" style="text;html=1;fontFamily=Mulish;fontSize=15;align=left;" vertex="1" parent="1">
