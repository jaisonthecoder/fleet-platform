          <mxGeometry x="40" y="516" width="1780" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b4t" value="BUSINESS MODULES &#8212; thin controller, rules in the service, data access only through TenantRepository" style="text;html=1;align=left;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#58595B;" vertex="1" parent="1">
