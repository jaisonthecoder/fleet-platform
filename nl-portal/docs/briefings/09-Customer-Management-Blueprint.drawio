        <mxGraphModel dx="1440" dy="1150" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1150">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Platform / Operating structure" style="text;html=1;fontFamily=Mulish;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="30" width="1000" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="button" value="Configure branch" style="rounded=0;html=1;fillColor=#AA272F;strokeColor=none;fontFamily=Mulish;fontSize=16;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="1150" y="30" width="250" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="tabs" value="Branches                                         Regions [only if managed-region model approved]" style="rounded=0;html=1;fillColor=#F5F5F3;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="115" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="filter" value="Search code or name          Source company [ ]          Country [ ]          Region [ ]          Status [ ]" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;spacingLeft=16;" vertex="1" parent="1">
                    <mxGeometry x="40" y="195" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="table" value="&lt;b&gt;Branch / code         Source company       Country / city       Region               Source state       Portal readiness&lt;/b&gt;&lt;br&gt;&lt;br&gt;[name + code]       [verified mapping]     [source values]      [if approved]       [active flag]        [configured / issue]&lt;br&gt;[name + code]       [verified mapping]     [source values]      [if approved]       [active flag]        [configured / issue]&lt;br&gt;&lt;br&gt;Previous / Next      Open branch" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="275" width="1360" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="branchDetail" value="&lt;b&gt;Branch detail / configure&lt;/b&gt;&lt;br&gt;&lt;br&gt;Source branch *: [approved catalogue selector]&lt;br&gt;Source instance / company: [mapping]&lt;br&gt;Branch code / name: [source read-only if supplied]&lt;br&gt;Country / city / operating address: [source if supplied]&lt;br&gt;Contact / timezone: [approved source/config fields]&lt;br&gt;Legal issuer: [verified relationship, not inferred]&lt;br&gt;Region: [approved assignment or optional label]&lt;br&gt;&lt;br&gt;Portal use: [enabled / disabled, approved lifecycle]&lt;br&gt;Staff assignments: [count] / Open staff (12)&lt;br&gt;Effective quotation settings / Open settings (09)&lt;br&gt;Reason *: [input]    Review / Confirm&lt;br&gt;&lt;br&gt;Readiness: mapping + permitted staff + resolved policy.&lt;br&gt;No live rate source is required or presumed." link="data:page/staff" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="480" width="660" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="regionDetail" value="&lt;b&gt;Region view | Decision-gated proposal&lt;/b&gt;&lt;br&gt;&lt;br&gt;Region list: code/name, member branches, status&lt;br&gt;Search / server paging / open region&lt;br&gt;&lt;br&gt;Create or edit region:&lt;br&gt;Region identifier *: [stable portal code]&lt;br&gt;Region name *: [input]&lt;br&gt;Branches: [approved membership selector]&lt;br&gt;Status: [approved lifecycle]&lt;br&gt;Effective settings: [read-only + authorised edit link]&lt;br&gt;Reason *: [input]&lt;br&gt;Review membership and policy impact / Confirm&lt;br&gt;&lt;br&gt;Alternative: region is only a branch label.&lt;br&gt;Then omit this view and region policy inheritance.&lt;br&gt;Do not imply Country &gt; Region &gt; Branch universally." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#002C5F;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="740" y="480" width="660" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="DESIGN NOTES | This is Noatum&#39;s structure, never customer warehouse management. Place it in Platform, not inside customer organisations.&lt;br&gt;Branch source, multi-branch customer servicing and region membership need D-03/D-18 decisions. No assumed multi-branch database relationship.&lt;br&gt;No source catalogue: require a business-approved maintained mapping, not an invented CW1 record. No write-back creates branches in CW1.&lt;br&gt;Branch code is not a UN/LOCODE or IATA code. Region is not legal issuer. Disabling/reassigning branches needs approved handling for staff, claims and jobs.&lt;br&gt;This blueprint is not approval to build a new Region table, operational HR system or geographical access inheritance." style="text;html=1;whiteSpace=wrap;fontFamily=Mulish;fontSize=17;fontColor=#58595B;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="40" y="960" width="1360" height="170" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="staff" name="12 Staff access assignment">
        <mxGraphModel dx="1440" dy="1020" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1020">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Platform / Staff users" style="text;html=1;fontFamily=Mulish;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="30" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="filter" value="Search name or email          Access: Unassigned / All          Branch: All          Role: All" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;spacingLeft=16;" vertex="1" parent="1">
                    <mxGeometry x="40" y="115" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="table" value="&lt;b&gt;Staff / email                   Branch                   Role presets                 Access                 Last sign-in            Action&lt;/b&gt;&lt;br&gt;&lt;br&gt;[eligible staff user]          Unassigned             None                            Awaiting assignment [date/time]            Assign access&lt;br&gt;[pricing staff user]          [branch]                  Pricing                         Active                  [date/time]            Review access&lt;br&gt;[platform admin]             [branch]                  Platform Admin             Active                  [date/time]            Review access&lt;br&gt;&lt;br&gt;Previous / Next" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="195" width="1360" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="assign" value="&lt;b&gt;Assign / review access | Drawer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Staff name / email / issuer binding [read-only]&lt;br&gt;Branch *: [authorised configured branch]&lt;br&gt;Role presets: [permitted internal multi-select]&lt;br&gt;Effective permissions: [read-only union]&lt;br&gt;Cross-branch pricing: [explicit granted permission]&lt;br&gt;Cost / restricted-content access: [explicit grants]&lt;br&gt;Reason *: [input]&lt;br&gt;&lt;br&gt;Cancel                          Review assignment&lt;br&gt;Review: previous/new branch, permissions, claim impact.&lt;br&gt;Confirm save; stale edit must not overwrite a newer grant." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="445" width="660" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="pending" value="&lt;b&gt;Staff first-login page&lt;/b&gt;&lt;br&gt;&lt;br&gt;NOATUM LOGISTICS&lt;br&gt;&lt;br&gt;Access awaiting assignment&lt;br&gt;[Signed-in name / email]&lt;br&gt;&lt;br&gt;Account        Sign out&lt;br&gt;&lt;br&gt;No business menus or customer data.&lt;br&gt;Only eligible staff identity is created.&lt;br&gt;Admin assignment enables permitted routes.&lt;br&gt;Authentication success is not role assignment." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="740" y="445" width="660" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="DESIGN NOTES | This page is distinct from Customer users. Staff roles are portal-managed, not taken from Azure groups or CW1 roles.&lt;br&gt;FR-IAM-002/003: eligible first login creates identity without access; explicit admin assigns roles and branch.&lt;br&gt;Pricing branch scope is enforced on requests; internal tracking is not branch-scoped. A header branch is context, not proof of all-page scoping.&lt;br&gt;Role/branch changes take effect on next request. Active claim recovery after revocation needs an approved rule; no permission persists via old quote policy.&lt;br&gt;No staff invitation/password form, custom role designer or first-login-wins bootstrap administrator." style="text;html=1;whiteSpace=wrap;fontFamily=Mulish;fontSize=17;fontColor=#58595B;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="40" y="835" width="1360" height="165" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="customeradmin" name="13 Customer acceptance and self-service">
        <mxGraphModel dx="1440" dy="1150" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1150">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Customer-facing journey | Invitation to user administration" style="text;html=1;fontFamily=Mulish;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="30" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="accept" value="&lt;b&gt;Accept invitation&lt;/b&gt;&lt;br&gt;&lt;br&gt;NOATUM LOGISTICS&lt;br&gt;Invitation to [customer]&lt;br&gt;Invited email: [masked as appropriate]&lt;br&gt;Invitation expiry: [date/time]&lt;br&gt;&lt;br&gt;Continue with Microsoft&lt;br&gt;&lt;br&gt;After Microsoft authentication:&lt;br&gt;Validate invite + identity binding&lt;br&gt;Accept invitation [explicit action]&lt;br&gt;Open customer workspace&lt;br&gt;&lt;br&gt;Expired / revoked / wrong account:&lt;br&gt;safe recovery, no customer data." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#002C5F;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="115" width="410" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="list" value="&lt;b&gt;Administration / Users&lt;/b&gt;&lt;br&gt;&lt;br&gt;Customer: [fixed own group]&lt;br&gt;Search name/email     Role [ ]     Status [ ]&lt;br&gt;&lt;br&gt;Name / email     Roles     Finance office     Status&lt;br&gt;[user]                [roles]    [office / all]       Active&lt;br&gt;[user]                [roles]    [office / all]       Invited&lt;br&gt;&lt;br&gt;Previous / Next&lt;br&gt;&lt;br&gt;Invite user        Open user&lt;br&gt;Own-group Audit&lt;br&gt;Company profile / linked offices [read-only]&lt;br&gt;&lt;br&gt;No global CW1 directory or staff admin controls." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="485" y="115" width="440" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="form" value="&lt;b&gt;Invite user / Edit roles&lt;/b&gt;&lt;br&gt;&lt;br&gt;Customer: [fixed, no editable tenant ID]&lt;br&gt;Display name *: [input]&lt;br&gt;Company email *: [input on invitation]&lt;br&gt;Locale *: [English / Spanish]&lt;br&gt;Role presets *: [external multi-select]&lt;br&gt;Financial office: [All permitted / one office]&lt;br&gt;Expiry: [configured, invitation only]&lt;br&gt;&lt;br&gt;Effective module access [preview]&lt;br&gt;Cancel         Send invitation / Review changes&lt;br&gt;&lt;br&gt;Internal role options never offered.&lt;br&gt;Out-of-domain invite blocked.&lt;br&gt;Last active admin cannot be removed." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="960" y="115" width="440" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="roles" value="&lt;b&gt;Role selector / permission preview&lt;/b&gt;&lt;br&gt;&lt;br&gt;[ ] Standard                 Tracking + approved documents&lt;br&gt;[ ] Quoting and Booking   Standard + quote/booking actions&lt;br&gt;[ ] Finance                    Standard + addressee-authorised finance&lt;br&gt;[ ] Analyst                    Standard + assigned reports&lt;br&gt;[ ] Claims                     Standard + released claim actions&lt;br&gt;[ ] Customer Admin         Standard + own-group administration&lt;br&gt;&lt;br&gt;Compatible roles combine permissions. Entitlement and release readiness are separate.&lt;br&gt;Financial-office restriction is not a shipment, quotation or general customer-office filter." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="530" width="880" height="295" as="geometry"/>
                </mxCell>
                <mxCell id="profile" value="&lt;b&gt;Company profile / offices&lt;/b&gt;&lt;br&gt;&lt;br&gt;Customer name / country / domains&lt;br&gt;Linked office display names&lt;br&gt;Approved CW1 address information&lt;br&gt;Source freshness / read-only marker&lt;br&gt;&lt;br&gt;Profile name/locale changes use own profile.&lt;br&gt;Master corrections: existing support route.&lt;br&gt;Operational Address book is separate.&lt;br&gt;No individual address tenancy links." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="960" y="530" width="440" height="295" as="geometry"/>
                </mxCell>
                <mxCell id="result" value="Invitation sent / delivery pending: return to Users; resend/revoke under configured controls.&lt;br&gt;Accepted user: only authorised, entitled modules; unreleased modules use approved unavailable state, never fabricated live data.&lt;br&gt;Deactivated user: next request denied even with valid Entra token. Customer Admin cannot impersonate another user." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;spacing=18;" vertex="1" parent="1">
                    <mxGeometry x="40" y="830" width="1360" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="DESIGN NOTES | Do not build a local account + MFA pathway. Microsoft-managed external identities can use supported methods configured by Identity team.&lt;br&gt;The screenshot label Local account + MFA is ambiguous, not proof of an implemented custom auth system. Replace with verified identity status only.&lt;br&gt;One external directory is not automatically one dedicated directory per customer. Federation is centrally configured, not an Edit company dropdown.&lt;br&gt;Noatum invites first admin; this is where the customer invites everyone else. Invite is not directory provisioning; identity-team sequence must be confirmed.&lt;br&gt;All module grants follow FR role matrix. Customer Admin is not a finance superuser. No arbitrary multi-company switching." style="text;html=1;whiteSpace=wrap;fontFamily=Mulish;fontSize=17;fontColor=#58595B;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="40" y="975" width="1360" height="165" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="exceptions" name="14 Invitations and unassigned entities">
        <mxGraphModel dx="1440" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1100">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Customer Success | Invitations and unassigned entities" style="text;html=1;fontFamily=Mulish;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="30" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="invites" value="&lt;b&gt;Invitations page&lt;/b&gt;&lt;br&gt;&lt;br&gt;Search email / customer       State [ ]       Expiry range [ ]&lt;br&gt;&lt;br&gt;Customer   Email   Roles   Invited by   Sent / expiry   Invite state   Delivery state   Actions&lt;br&gt;[group]      [email] [roles] [actor]         [date/time]     [invited]      [sent]              Open&lt;br&gt;[group]      [email] [roles] [actor]         [date/time]     [expired]     [sent]              Open&lt;br&gt;&lt;br&gt;Row detail: customer, invited identity, role presets, finance office if applicable, expiry, acceptance, resend history.&lt;br&gt;Resend [within policy] / Revoke [confirm] / Open customer. No raw token display.&lt;br&gt;Delivery failed is not invitation revoked; controlled retry does not create another customer/user.&lt;br&gt;Previous / Next" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="115" width="1360" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="unassigned" value="&lt;b&gt;Unassigned entities page&lt;/b&gt;&lt;br&gt;&lt;br&gt;Search source reference       Entity type [available types]       Source instance [ ]       First seen [range]&lt;br&gt;&lt;br&gt;Entity reference    Type             Source org/address code    Resolution issue           First / last seen      Action&lt;br&gt;[reference]           [available]     [source-qualified code]      [unknown / ambiguous] [timestamps]          Inspect&lt;br&gt;&lt;br&gt;Detail: original party reference, source namespace, resolved organisation if known, source record + mapping outcome.&lt;br&gt;No customer visibility granted from inspection. Do not show unsupported shipment/invoice modules as live in P1.&lt;br&gt;Actions: Open source organisation (03) / Link known organisation (05) / Open integration diagnostics.&lt;br&gt;Unknown source/address mapping: resolve with master-data/integration owner; no free-text tenant override.&lt;br&gt;Previous / Next" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="445" width="1360" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="resolution" value="Inspect exception" style="rounded=0;html=1;fillColor=#F5F5F3;strokeColor=#002C5F;fontFamily=Mulish;fontSize=17;" vertex="1" parent="1">
                    <mxGeometry x="40" y="785" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="resolve" value="Resolve source organisation&lt;br&gt;Known and eligible?" link="data:page/orgdetail" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#002C5F;fontFamily=Mulish;fontSize=17;" vertex="1" parent="1">
                    <mxGeometry x="385" y="785" width="290" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="link" value="Audited organisation link&lt;br&gt;Reason + confirmation" link="data:page/onboard1" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Mulish;fontSize=17;" vertex="1" parent="1">
                    <mxGeometry x="770" y="785" width="290" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="refresh" value="Re-evaluate eligible visibility&lt;br&gt;Show outcome" style="rounded=0;html=1;fillColor=#F5F5F3;strokeColor=#002C5F;fontFamily=Mulish;fontSize=17;" vertex="1" parent="1">
                    <mxGeometry x="1150" y="785" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="resolution" target="resolve">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="resolve" target="link">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="link" target="refresh">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="DESIGN NOTES | CW1 organisations is a master directory; Unassigned entities is a transaction-resolution queue. They are not interchangeable.&lt;br&gt;Unknown or ambiguous party/address codes fail closed under OQ-3a. A known unlinked organisation uses the deliberate linking workflow.&lt;br&gt;No unrestricted source payloads, customer-group discovery or automatic reassignment. Historical quotes retain ownership/snapshot rules; do not bulk move them.&lt;br&gt;Mapping approval list is optional only if signed off. No new ticket system, reconciliation state machine or independent approval-table machinery is approved." style="text;html=1;whiteSpace=wrap;fontFamily=Mulish;fontSize=17;fontColor=#58595B;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="40" y="915" width="1360" height="160" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="safety" name="15 Confirmations recovery and support">
        <mxGraphModel dx="1440" dy="1150" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1150">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Shared confirmations, recovery and support states" style="text;html=1;fontFamily=Mulish;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="30" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="impersonation" value="&lt;b&gt;View as customer user | Support dialog&lt;/b&gt;&lt;br&gt;&lt;br&gt;Customer: [fixed]&lt;br&gt;User *: [eligible user selector]&lt;br&gt;Reason *: [mandatory support reason]&lt;br&gt;Duration: [configured; default 60 minutes]&lt;br&gt;Mode: Read-only [fixed]&lt;br&gt;Cancel                    Start read-only view&lt;br&gt;&lt;br&gt;Persistent banner: Viewing as [user] | [time left] | End&lt;br&gt;Original and effective actor in audit. Every write denied.&lt;br&gt;Expired / deactivated: end view and return to support." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="115" width="650" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="suspend" value="&lt;b&gt;Suspend customer / deactivate user&lt;/b&gt;&lt;br&gt;&lt;br&gt;Target: [customer or user]&lt;br&gt;Impact: [all group users / selected user&#39;s access]&lt;br&gt;Reason *: [input]&lt;br&gt;[ ] Confirm access removal *&lt;br&gt;Cancel                    Confirm suspension/deactivation&lt;br&gt;&lt;br&gt;Customer suspension retains source data and ingestion.&lt;br&gt;User action cannot remove last active Customer Admin.&lt;br&gt;Reactivate requires permitted role and current eligibility.&lt;br&gt;Never Delete CW1 organisation as part of this action." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="730" y="115" width="670" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="relink" value="&lt;b&gt;Link / unlink / reassign review&lt;/b&gt;&lt;br&gt;&lt;br&gt;Source organisation: [source-qualified identity]&lt;br&gt;Current customer: [permitted target]&lt;br&gt;Proposed customer/link: [explicit selection]&lt;br&gt;Reason * + access-impact confirmation *&lt;br&gt;Impact: old/new visibility, active office count, affected users&lt;br&gt;No address-level reassignment. Reject conflicting ownership.&lt;br&gt;Last-office removal requires approved activation handling.&lt;br&gt;Historical quote/booking ownership requires explicit policy.&lt;br&gt;Do not implement a one-click reassignment bypass.&lt;br&gt;Optional second-person review only after business sign-off." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="460" width="650" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="states" value="&lt;b&gt;List / form recovery states&lt;/b&gt;&lt;br&gt;&lt;br&gt;Loading: stable row placeholders; no false zero counts.&lt;br&gt;Empty: No customers yet + permitted Onboard action.&lt;br&gt;No matches: retain filters + Clear filters.&lt;br&gt;Sync failure: last success time + authorised issue link.&lt;br&gt;Validation: field-specific error + focus first invalid field.&lt;br&gt;Save failure: preserve inputs; no success badge.&lt;br&gt;Concurrent update: reload latest + review differences.&lt;br&gt;Access denied: no protected fields or hidden data count.&lt;br&gt;Expired invite: request resend via existing admin channel.&lt;br&gt;Unavailable module: no live controls or mock business data." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="730" y="460" width="670" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="save" value="Common save flow: edit fields -&gt; validate -&gt; review before/after and impact -&gt; reason/confirmation -&gt; server write + audit -&gt; outcome.&lt;br&gt;Background jobs: show queued/delivery/sync outcome separately. Never repeat a business creation to retry a failed email.&lt;br&gt;Last-admin, duplicate-link and role checks apply under concurrent actions. Tenant IDs from a browser are never trusted for data scope." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#002C5F;fontFamily=Mulish;fontSize=17;align=left;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="810" width="1360" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="DESIGN NOTES | Impersonation is already required by FR-IAM-012; retain it with controls, do not invent full write-capable impersonation.&lt;br&gt;Screenshot buttons do not demonstrate whether protections exist. These are acceptance requirements, not confirmed backend vulnerabilities.&lt;br&gt;Architecture explanations belong in documentation/help, not repeated How access works cards. Labels must still explain actual destructive impact.&lt;br&gt;All dialogs are keyboard reachable, trap/restore focus, have accessible names and announce validation/save outcomes. Reason fields are not credentials." style="text;html=1;whiteSpace=wrap;fontFamily=Mulish;fontSize=17;fontColor=#58595B;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="40" y="980" width="1360" height="145" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="responsive" name="16 Responsive layouts and delivery gates">
        <mxGraphModel dx="1440" dy="1150" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1150">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Responsive page patterns and design approval gates" style="text;html=1;fontFamily=Mulish;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1">
