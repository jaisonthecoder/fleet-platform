{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm verify*)",
      "Bash(pnpm build*)",
      "Bash(pnpm -r *)",
      "Bash(pnpm --filter *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(docker compose -f infra/docker-compose.yml ps*)",
      "Bash(docker compose -f infra/docker-compose.yml logs*)"
    ],
    "deny": [
      "Read(./apps/noatum-customer-portal-api/.env)",
      "Read(./apps/noatum-customer-portal-ui/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Edit(./apps/noatum-customer-portal-api/.env)",
      "Edit(./apps/noatum-customer-portal-ui/.env)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(pnpm --filter noatum-customer-portal-api run migrate:deploy*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(pnpm --filter noatum-customer-portal-api run migrate*)",
      "Edit(./CLAUDE.md)",
      "Edit(./docs/adr/**)"
    ]
  }
}
