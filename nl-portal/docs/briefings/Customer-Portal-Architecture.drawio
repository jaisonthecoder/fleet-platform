        <!-- ===== BAND 3 : guards ===== -->
        <mxCell id="b3" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#AA272F;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="392" width="1780" height="104" as="geometry" />
        </mxCell>
        <mxCell id="b3t" value="API &#8212; NestJS, REST, OpenAPI.&#160;&#160;EVERY request passes four gates, in this order. A route that declares no permission is REFUSED, not allowed." style="text;html=1;align=left;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#AA272F;" vertex="1" parent="1">
          <mxGeometry x="54" y="398" width="1400" height="18" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="1&#160;&#160;AuthGuard&#10;&lt;br&gt;portal session cookie, or Entra token.&#10;&lt;br&gt;Roles come from OUR database, never the token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="422" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="2&#160;&#160;TenantGuard&#10;&lt;br&gt;which customer is in scope.&#10;&lt;br&gt;A customer can never ask for another" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="500" y="422" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="3&#160;&#160;PermissionGuard&#10;&lt;br&gt;54 permission codes, 11 role presets.&#10;&lt;br&gt;Fails CLOSED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="940" y="422" width="420" height="64" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="4&#160;&#160;FeatureGuard&#10;&lt;br&gt;is this capability switched on&#10;&lt;br&gt;for this customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Helvetica;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1380" y="422" width="420" height="64" as="geometry" />
        </mxCell>

