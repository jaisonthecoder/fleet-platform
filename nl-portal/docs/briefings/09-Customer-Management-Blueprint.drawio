    <diagram id="settings" name="09 Entitlements and quotation settings">
        <mxGraphModel dx="1440" dy="1150" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1440" pageHeight="1150">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="[Customer] / Features and settings" link="data:page/detail" style="text;html=1;fontFamily=Mulish;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1">
                    <mxGeometry x="40" y="30" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="tabs" value="Feature entitlements                                     Effective quotation settings" style="rounded=0;html=1;fillColor=#F5F5F3;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=18;align=left;spacingLeft=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="105" width="1360" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="table" value="&lt;b&gt;Feature                         Customer entitlement       Release readiness            User permission&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quotations                     [on/off control]                 [release catalogue]          Separately assigned&lt;br&gt;Track and trace             [on/off control]                 P2                               Separately assigned&lt;br&gt;Documents                    [on/off control]                 P2                               Separately assigned&lt;br&gt;Invoices                         [on/off control]                 P2                               Addressee + finance scope&lt;br&gt;Bookings                        [on/off control]                 P3                               Separately assigned&lt;br&gt;Claims                            [on/off control]                 P3                               Separately assigned&lt;br&gt;Other approved features [on/off control]                 [actual readiness]            Separately assigned" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="180" width="1360" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="policy" value="&lt;b&gt;Effective quotation settings&lt;/b&gt;&lt;br&gt;&lt;br&gt;Setting                             Effective value                    Inherited from              Override&lt;br&gt;Priced-offer publication     [Direct / CW1-confirmed]     [platform / branch / ...]  [approved scope only]&lt;br&gt;Initial request sync            [enabled / disabled]            [source]                      [state]&lt;br&gt;Internal approval               [enabled + approved rule]    [source]                      [state]&lt;br&gt;Claim expiry                      [approved duration]             [source]                      [state]&lt;br&gt;Cost capture / carrier name [approved values]               [source]                      [state]&lt;br&gt;Validity / terms                  [approved defaults]             [source]                      [state]&lt;br&gt;Email template / drafting    [template / enabled]             [source]                      [state]&lt;br&gt;&lt;br&gt;Policy revision: [revision]       Open quotation settings editor" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F5F5F3;strokeColor=#E5E5E5;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="40" y="490" width="900" height="355" as="geometry"/>
                </mxCell>
                <mxCell id="editor" value="&lt;b&gt;Settings editor | Platform page&lt;/b&gt;&lt;br&gt;&lt;br&gt;Scope type *: [approved options]&lt;br&gt;Scope target *: [permitted target]&lt;br&gt;Setting *: [per-scope catalogue]&lt;br&gt;( ) Inherit     ( ) Override&lt;br&gt;Value: [typed control]&lt;br&gt;Effective preview: [value + source]&lt;br&gt;Reason *: [input]&lt;br&gt;&lt;br&gt;Cancel     Review change&lt;br&gt;&lt;br&gt;Review: affected scope, before/after,&lt;br&gt;revision, in-flight policy treatment.&lt;br&gt;Confirm save / conflict recovery." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#AA272F;fontFamily=Mulish;fontSize=17;align=left;verticalAlign=top;spacing=20;" vertex="1" parent="1">
                    <mxGeometry x="970" y="490" width="430" height="385" as="geometry"/>
                </mxCell>
                <mxCell id="save" value="Review entitlement changes" style="rounded=0;html=1;fillColor=#AA272F;strokeColor=none;fontFamily=Mulish;fontSize=16;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="875" width="320" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="note" value="SCREENSHOT 5 | Keep feature controls but separate availability from permissions. Carrier disclosure is a quotation policy, not a general module.&lt;br&gt;Future module entitlement may be prepared in P1, but cannot activate unreleased functionality. Show actual release readiness; do not fake toggles that enable it.&lt;br&gt;Changes take effect on the next API request, not only next navigation. Review/confirm/reason/audit; no optimistic saved state after failure.&lt;br&gt;D-18 gates region/branch/customer precedence and values. New work uses new policy; existing quotes retain recorded policy unless approved re-evaluation.&lt;br&gt;Never disable tenancy, permissions, audit, human-send, cost protection or accepted-version immutability. Claim-release authority belongs to role permissions." style="text;html=1;whiteSpace=wrap;fontFamily=Mulish;fontSize=17;fontColor=#58595B;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="40" y="960" width="1360" height="175" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
