                </mxCell>
                <mxCell id="onboard" value="Onboard customer" link="data:page/onboard1" style="rounded=0;html=1;fillColor=#AA272F;strokeColor=none;fontFamily=Mulish;fontSize=16;fontColor=#FFFFFF;" vertex="1" parent="1">
